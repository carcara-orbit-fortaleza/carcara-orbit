# ── Copie para .env ─────────────────────────────────────────────────────
#   cp .env.example .env

# ── Docker Compose ──────────────────────────────────────────────────────
NODE_ENV=development
# Portas publicadas no host apenas no modo desenvolvimento. Se outra API já
# usa 3000 na mesma máquina, use API_PORT=3100 e ajuste VITE_API_URL para
# http://localhost:3100/api.
API_PORT=3000
WEB_PORT=5173

# ── Postgres ────────────────────────────────────────────────────────────
# O Compose monta DATABASE_URL a partir destas variáveis dentro do container.
DB_USER=carcara
DB_PASSWORD=change-me-strong-password
DB_NAME=carcara
# Porta publicada apenas no ambiente de desenvolvimento.
DB_PORT=5432
DB_POOL_MAX=10
# Para rodar a API fora do Docker, use:
# DATABASE_URL=postgresql://carcara:change-me-strong-password@localhost:5432/carcara

# Origem autorizada a chamar a API diretamente no navegador (dev).
# Aceita uma lista separada por vírgulas.
CORS_ORIGIN=http://localhost:5173

# URL usada pelo front no modo dev. Deve ser acessível pelo NAVEGADOR.
# Em produção o compose fixa VITE_API_URL=/api (mesma origem via nginx).
VITE_API_URL=http://localhost:3000/api

# ── API: fonte de dados ─────────────────────────────────────────────────
# NASA FIRMS MAP_KEY (https://firms.modaps.eosdis.nasa.gov/api/map_key/)
FIRMS_MAP_KEY=

# mock | real (um data/runtime/mode.json salvo tem precedência)
DATA_SOURCE=mock
# REAL_DATA_DIR=./data/real
# MOCK_DATA_DIR=./data/mock
# DATASET_MODE_FILE=./data/runtime/mode.json
# Regiões do pipeline (padrão: api/pipeline/config/regions.json).
# Para outro país/recorte global, aponte para um GeoJSON com o mesmo contrato.
# REGIONS_FILE=./pipeline/config/regions.json

# ── API: ingestão global (banco separado do dataset Brasil) ─────────────
GLOBAL_DB_PATH=./data/db/global.sqlite
GLOBAL_RAW_DIR=./data/raw/global
# Grade mundial em graus (5-60). 10° gera 648 células.
GLOBAL_GRID_DEGREES=10
# Tiles usados nas requisições NRT globais (5-60).
GLOBAL_NRT_TILE_DEGREES=30
GLOBAL_START_YEAR=2000
# Deixe vazio para usar o ano anterior ao atual.
GLOBAL_END_YEAR=
# Limite opcional de arquivos por execução (o checkpoint retoma).
GLOBAL_MAX_FILES=

# Proteção opcional para POST /api/mode, /api/ingestion/run e /api/nrt/refresh
ADMIN_TOKEN=

# ── API: atualização NRT ────────────────────────────────────────────────
NRT_ENABLED=false
NRT_INTERVAL_MINUTES=180
NRT_DAYS=2
NRT_REGIONS=
FIRMS_SOURCES=MODIS_NRT,VIIRS_NOAA20_NRT,VIIRS_NOAA21_NRT
# FIRMS_ARCHIVE_SOURCES=MODIS_SP,VIIRS_NOAA20_SP,VIIRS_NOAA21_SP

# ── API: histórico SQLite ───────────────────────────────────────────────
FIRMS_DB_PATH=./data/db/firms.sqlite
FIRMS_COUNTRY=Brazil
FIRMS_HISTORY_START_YEAR=2000
HOTSPOTS_EXPORT_MONTHS=24

# ── API: pipeline ───────────────────────────────────────────────────────
PIPELINE_TIMEOUT_MS=900000
MODIS_MIN_CONFIDENCE=30
VIIRS_MIN_CLASS=nominal
CALIBRATION_START_YEAR=2012
CALIBRATION_END_YEAR=2025
BASELINE_START_YEAR=2003
BASELINE_END_YEAR=2025
CALIBRATION_MIN_CELLS=30
CALIBRATION_SHRINKAGE_K=20
CALIBRATION_MIN_FACTOR=0.5
CALIBRATION_MAX_FACTOR=4.0
MAX_MAP_POINTS=2000
MAX_EXPORT_ROWS=50000

# ── API: explicação com IA (POST /api/explain, nível 3) ─────────────────
# Desligado por padrão e FAIL CLOSED: sem chave E sem EXPLAIN_ENABLED=true, responde 503.
# Nunca commite a chave real.
GEMINI_API_KEY=
EXPLAIN_ENABLED=false
EXPLAIN_MODEL=gemini-3.5-flash-lite
# Teto diário de tokens (entrada+saída), em memória, zera por dia UTC, por instância.
EXPLAIN_DAILY_TOKEN_BUDGET=200000
# Saltos de proxy confiáveis para o IP do rate limit. Vazio = desligado.
# Produção atual (Traefik -> nginx do web -> api): 1.
EXPLAIN_TRUST_PROXY=
# Opcional: limites por IP (padrão 6/min e 40/hora)
# EXPLAIN_RATE_PER_MINUTE=6
# EXPLAIN_RATE_PER_HOUR=40

# ── Produção (docker-compose.prod.yml) ──────────────────────────────────
# Subdomínio público roteado pelo Traefik que já roda na VPS.
APP_HOST=app.example.com

# ── Traefik existente na VPS (edge em 80/443) ──────────────────────────
# Nome exato da rede Docker do Traefik (`docker network ls`).
TRAEFIK_NETWORK=traefik-proxy
# Entrypoint de TLS e certresolver ACME usados por esse Traefik.
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=le
