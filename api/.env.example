# NASA FIRMS MAP_KEY (https://firms.modaps.eosdis.nasa.gov/api/map_key/)
FIRMS_MAP_KEY=

# Server
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Data mode: mock | real (a saved data/runtime/mode.json takes precedence)
DATA_SOURCE=mock
# REAL_DATA_DIR=./data/real
# MOCK_DATA_DIR=./data/mock
# DATASET_MODE_FILE=./data/runtime/mode.json

# Optional admin protection for POST /api/mode, /api/ingestion/run, /api/nrt/refresh
ADMIN_TOKEN=

# NRT
NRT_ENABLED=false
NRT_INTERVAL_MINUTES=180
NRT_DAYS=2
NRT_REGIONS=
FIRMS_SOURCES=MODIS_NRT,VIIRS_NOAA20_NRT,VIIRS_NOAA21_NRT
# FIRMS_ARCHIVE_SOURCES=MODIS_SP,VIIRS_NOAA20_SP,VIIRS_NOAA21_SP

# SQLite historical database
FIRMS_DB_PATH=./data/db/firms.sqlite
FIRMS_COUNTRY=Brazil
FIRMS_HISTORY_START_YEAR=2000
HOTSPOTS_EXPORT_MONTHS=24

# Pipeline
PIPELINE_TIMEOUT_MS=900000
MODIS_MIN_CONFIDENCE=30
VIIRS_MIN_CLASS=nominal
CALIBRATION_START_YEAR=2012
CALIBRATION_END_YEAR=2025
BASELINE_START_YEAR=2003
BASELINE_END_YEAR=2025
CALIBRATION_MIN_CELLS=30
CALIBRATION_SHRINKAGE_K=20
CALIBRATION_MIN_FACTOR=0.5
CALIBRATION_MAX_FACTOR=4.0
MAX_MAP_POINTS=2000
MAX_EXPORT_ROWS=50000
